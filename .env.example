# Copy to .env and fill in as needed. Used by api.py, ui.py, and docker-compose.yml.

# Shared secret required on /ask via the X-API-Key header.
# Unset = unauthenticated /ask (fine for local dev, not for anything network-reachable).
API_KEY=

# Comma-separated origins allowed to call the API (api.py CORS).
ALLOWED_ORIGINS=http://localhost:8501

# Rate limit applied to /ask, e.g. "20/minute", "5/second".
ASK_RATE_LIMIT=20/minute

# Where api.py reaches Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Where ui.py reaches the FastAPI backend.
API_BASE_URL=http://127.0.0.1:8000
